{
  "name": "games-reducer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build && node scripts/static-routes.mjs && node scripts/build-offline.mjs",
    "start": "vite preview --host 127.0.0.1 --port 3001",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-only-check.mjs",
    "engine:download": "node scripts/download-engine.mjs && node scripts/prepare-engine.mjs",
    "dev:legacy": "node scripts/dev.mjs",
    "test:browser:legacy": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "jsnes": "^2.1.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
